while IFS= read -r id; do
  [ -z "$id" ] && continue
  sub="sub-$id"

  for ses in ses-01 ses-02; do
    srcdir="$src/$sub/$ses"
    destdir="$dest/$sub/$ses"

    if [ -d "$srcdir" ]; then
      mkdir -p "$destdir"
      found=0

      while IFS= read -r -d '' d; do
        found=1
        cp -a "$d" "$destdir/"
      done < <(find "$srcdir" -maxdepth 1 -type d -name 'DTI32*' -print0)

      if [ "$found" -eq 0 ]; then
        echo "No DTI32* directories found in: $srcdir"
      fi
    else
      echo "Directory not found: $srcdir"
    fi
  done
done < "$idfile"

