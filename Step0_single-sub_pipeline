## Set up enviorment
ml mamba
source activate myENV
cd /scratch/cbayouth/Longitudinal FBA

#Step 1
mrconvert sub-10147/ses-02/*/ sub-10147/ses-02/dwi.mif -vox 2 -coord 3 '0:1:32'
dwidenoise sub-10147/ses-02/dwi.mif  sub-10147/ses-02/step1_denoised.mif
mrdegibbs sub-10147/ses-02/step1_denoised.mif" sub-10147/ses-02/step1_unringed.mif"         

#step 2
dwifslpreproc sub-10147/ses-02/step1_unringed.mif sub-10147/ses-02/step2_fsl.mif -rpe_none -pe_dir AP -readout_time 0.1 -eddy_options " --slm=linear "

#step 3

module purge
ml mamba
source activate myENV
ml ants

dwi2mask sub-10147/ses-02/step2_fsl.mif sub-10147/ses-02/step3.1_tempmask.mif 
maskfilter sub-10147/ses-02/step3.1_tempmask.mif dilate sub-10147/ses-02/step3.2_dialatemask.mif 
dwibiascorrect ants sub-10147/ses-02/step2_fsl.mif  sub-10147/ses-02/step3.3_ants.mif

#Step4
mkdir dwinormalise
mkdir dwi_input
mkdir mask_input
ln -sr sub-10147/ses-02/step3.3_ants.mif dwinormalise/dwi_input/10008v2.mif -force
ln -sr sub-10147/ses-02/step3.2_dialatemask.mif dwinormalise/mask_input/10008v2.mif -force
dwinormalise group dwinormalise/dwi_input/ dwinormalise/mask_input/ dwinormalise/dwi_output/ dwinormalise/fa_template.mif dwinormalise/fa_template_wm_mask.mif


module purge
ml mamba
source activate myENV


# preproc
for ID in 10001 10002 10003 10004 10005 10006 10007 10008 10009 10010 10011 10013 10014 10015 10016 10017 10018 10019 10020 10021 10029 10036 10040 10042 10044 10046 10050 10052 10057 10059 10060 10061 10069 10076 10077 10079 10086 10088 10090 10091 10092 10093 10096 10101 10103 10106 10107 10109 10112 10113 10114 10115 10119 10124 10129 10136 10137 10147 11001 11003 11006 11007 11008 11009 11012 11013 11014 11016 11017 11019 11021 11027 11028 11030 11031 11032 11033 11038 11039 11041 11042 11044 11046 11054 11055 11056 11059 11061 11070 11071 11074 11081 11082 11084 11085 11086 11087 11088 11092; do
    for n in 01 02 03 04 05 06; do
        SES_DIR="sub-${ID}/ses-${n}"
        # skip if the session directory doesn't exist
        if [[ ! -d "$SES_DIR" ]]; then
            echo "-- Skipping sub-${ID} ses-${n} (no session directory)"
            continue
        fi
        echo ">> Denoising and Giibs sub-${ID} ses-${n} - Step 1"
        dwidenoise sub-10147/ses-02/dwi.mif"  sub-10147/ses-02/step1_denoised.mif"
        mrdegibbs sub-10147/ses-02/step1_denoised.mif" sub-10147/ses-02/step1_unringed.mif"         

    done
done

